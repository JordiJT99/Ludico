NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ludico:ludico@localhost:5432/ludico
LOG_LEVEL=info
BUSINESS_TIME_ZONE=Europe/Madrid
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
ADMIN_API_KEY=replace-with-at-least-32-random-characters
# Token interno distinto de ADMIN_API_KEY (mínimo 32 caracteres); deja vacío para ocultar /metrics.
METRICS_TOKEN=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Nunca use IDs publicitarios reales fuera de producción.
ADS_MODE=disabled
EXPO_PUBLIC_ADS_MODE=disabled
AI_PROVIDER=disabled
AI_JOB_BUDGET_MICROS=0
# Solo para AI_PROVIDER=openai; usar secretos del entorno, nunca valores en el repositorio.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=
# Estimación configurable de coste por token en micro-unidades monetarias.
OPENAI_INPUT_TOKEN_MICROS=0
OPENAI_OUTPUT_TOKEN_MICROS=0

# Las notificaciones requieren build nativa, dispositivo físico y una clave base64 de 32 bytes.
PUSH_PROVIDER=disabled
NOTIFICATION_TOKEN_KEY_BASE64=
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_PUSH_ENABLED=false
EXPO_PUBLIC_EAS_PROJECT_ID=
