{
  "name": "@ludico/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --conditions=development watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ludico/contracts": "workspace:*",
    "@ludico/database": "workspace:*",
    "@ludico/domain": "workspace:*",
    "fastify": "^5.10.0"
  }
}
