{
  "name": "@ludico/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/migrate.ts",
    "db:seed": "tsx --conditions=development --env-file-if-exists=../../.env src/seed.ts",
    "test": "vitest run src --testTimeout 15000 --hookTimeout 15000 --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ludico/contracts": "workspace:*",
    "@ludico/domain": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
