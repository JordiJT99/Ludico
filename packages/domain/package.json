{
  "name": "@ludico/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./crossword": {
      "development": "./src/crossword.ts",
      "react-native": "./src/crossword.ts",
      "default": "./dist/crossword.js"
    },
    "./crossword-progress": {
      "development": "./src/crossword-progress.ts",
      "react-native": "./src/crossword-progress.ts",
      "default": "./dist/crossword-progress.js"
    },
    "./quiz-progress": {
      "development": "./src/quiz-progress.ts",
      "react-native": "./src/quiz-progress.ts",
      "default": "./dist/quiz-progress.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ludico/contracts": "workspace:*",
    "@js-temporal/polyfill": "0.5.1"
  }
}
